# Example Corefile for manual use.
# The app generates dns/Corefile automatically from the .env values.
# This example uses the reserved test domain and documentation IPs.
#
# CoreDNS only answers the local domain; everything else is refused, so the
# container is not an open resolver. Known hosts come from the hosts file,
# misses are rewritten to <name>.fritz.box and forwarded to the FRITZ!Box.

example.test:53 {
    errors
    reload 30s
    health :8080
    ready :8181
    hosts /zones/hosts example.test {
        ttl 60
        reload 5s
        no_reverse
        fallthrough
    }
    forward . 127.0.0.1:5354
    cache 30
}

.:5354 {
    bind 127.0.0.1
    errors
    log . "{name} {type} {rcode}"
    rewrite stop {
        name regex ^([^.]+)\.example\.test\.$ {1}.fritz.box.
        answer name ^([^.]+)\.fritz\.box\.$ {1}.example.test.
    }
    forward . 192.0.2.1:53
}
