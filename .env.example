BoxIP='192.0.2.1'
BoxUSER='fritz-user'
BoxPW='fritz-password'

# Optional: FRITZ-Repeater ausserhalb des Mesh (z. B. hinter OpenWrt),
# direkt per TR-064 abfragen. Zugangsdaten default = BoxUSER/BoxPW.
FRITZ_REPEATER_IPS=
FRITZ_REPEATER_USER=
FRITZ_REPEATER_PW=
FRITZ_REPEATER_TIMEOUT=25

FETCH_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=1

HTTP_SCAN_ENABLED=1
HTTP_SCAN_TIMEOUT=1.0
HTTP_SCAN_WORKERS=16
HTTP_SCAN_FAIL_THRESHOLD=2

WEB_HOST=0.0.0.0
WEB_PORT=8346

DNS_DOMAIN=example.test
DNS_ZONE_TTL=60
DNS_INCLUDE_IPV6=0
DNS_HOST_RETENTION_DAYS=90
DNS_FALLBACK_ENABLED=1
DNS_FALLBACK_MODE=fritz.box
# Der Fallback geht immer an <BoxIP>:53.
DNS_NS_IP=192.0.2.10

SNAPSHOT_RETENTION_DAYS=90
RAW_RETENTION_DAYS=30

# WLAN-Auffälligkeiten aus dem FRITZ!Box-Ereignisprotokoll
FRITZ_EVENTLOG_ENABLED=1
EVENT_RETENTION_DAYS=90

# Optional: OpenWrt als zweite Host-Quelle (ubus/JSON-RPC über /ubus)
OPENWRT_ENABLED=0
OPENWRT_URL=http://192.0.2.3
OPENWRT_USER=ubusro
OPENWRT_PASSWORD=openwrt-password
OPENWRT_TIMEOUT=25
OPENWRT_VERIFY_TLS=0
# Optional: Mesh-Node-IP, unter der OpenWrt-Clients in der Topologie haengen
OPENWRT_TOPOLOGY_PARENT_IP=
# Optional: MWAN3-Status im Dashboard anzeigen (falls mwan3 installiert ist)
OPENWRT_MWAN3_ENABLED=1
